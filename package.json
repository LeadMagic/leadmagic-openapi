{
  "name": "leadmagic-openapi",
  "private": true,
  "version": "0.1.0",
  "description": "Validation and smoke-test tooling for the LeadMagic OpenAPI snapshot",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint:openapi": "spectral lint leadmagic-openapi-3.1.yaml",
    "test:api": "tsx test-api.ts",
    "typecheck": "tsc --noEmit",
    "check:public": "node scripts/check-public-surface.mjs && python3 scripts/check-public-files.py",
    "test": "node --test scripts/public-surface.test.mjs"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.16.3",
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  }
}
